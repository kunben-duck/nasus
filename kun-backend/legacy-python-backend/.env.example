# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/autotest_platform
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/autotest_platform

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=autotest-platform
MINIO_SECURE=false

# Application Configuration
APP_NAME=AutoTest Platform
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Midscene.js Configuration
MIDSCENE_API_KEY=your-midscene-api-key
MIDSCENE_API_URL=https://api.midscene.ai
