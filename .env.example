# Nasus local development configuration
#
# Copy this file to .env for local development. Never commit real API keys.

# Dockerized infrastructure
# Start with: docker compose up -d postgres minio minio-init
POSTGRES_DB=nasus
POSTGRES_USER=nasus
POSTGRES_PASSWORD=nasus_dev_password
POSTGRES_PORT=5432

MINIO_ROOT_USER=nasus
MINIO_ROOT_PASSWORD=nasus_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
NASUS_S3_ENDPOINT=http://127.0.0.1:9000
NASUS_S3_BUCKET=nasus-artifacts
NASUS_S3_ACCESS_KEY=nasus
NASUS_S3_SECRET_KEY=nasus_dev_password
NASUS_S3_REGION=us-east-1

# System-image source connectors
# Production must explicitly allow every Git host. Tokens are referenced as env:VARIABLE on a source binding.
NASUS_SOURCE_CACHE_DIR=.nasus/source-cache
NASUS_GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
NASUS_GIT_ALLOWED_SCHEMES=https,ssh,git
NASUS_GIT_CLONE_TIMEOUT_SECONDS=120
NASUS_SOURCE_MAX_FILES=5000
NASUS_SOURCE_MAX_BYTES=104857600
NASUS_SOURCE_MAX_SINGLE_FILE_BYTES=10485760

# Replaceable code-graph enrichment. Tree-sitter remains the canonical
# structural extractor. optional records failures as evidence; required fails closed.
NASUS_CODE_GRAPH_MODE=optional
NASUS_CODE_GRAPH_BINARY=codebase-memory-mcp
NASUS_CODE_GRAPH_INDEX_MODE=moderate
NASUS_CODE_GRAPH_TIMEOUT_SECONDS=180
NASUS_CODE_GRAPH_MAX_ENTITIES=10000
NASUS_CODE_GRAPH_MAX_RELATIONSHIPS=25000
NASUS_CODE_GRAPH_PAGE_SIZE=500
NASUS_CODE_GRAPH_CACHE_DIR=.nasus/code-graph-cache

# Runtime profile
# local allows developer fallbacks. staging/production fail fast unless durable infrastructure is explicitly configured.
NASUS_ENV=local

# API persistence
# Production/dev should use Docker PostgreSQL. SQLite is only a local fallback for isolated tests.
NASUS_DATABASE_URL=postgresql+psycopg://nasus:nasus_dev_password@127.0.0.1:5432/nasus
NASUS_AUTO_CREATE_TABLES=false
NASUS_STATE_DIR=.nasus-state
NASUS_SEED_DEMO_DATA=false
# Shared by API and workflow workers so model API keys remain decryptable
# after process restarts or horizontal scaling.
NASUS_SETTINGS_ENCRYPTION_SECRET=replace-with-a-random-32-byte-settings-encryption-secret

# Durable SSE replay/outbox
NASUS_SSE_RETENTION_DAYS=7
NASUS_SSE_POLL_SECONDS=0.5
NASUS_SSE_HEARTBEAT_SECONDS=15

# Isolated Playwright runner
# For local development, run `npm --prefix apps/runner start` and use localhost.
# Staging/production must use HTTP mode, a dedicated service token, and an explicit target-host allowlist.
NASUS_RUNNER_MODE=http
NASUS_RUNNER_ENDPOINT=http://127.0.0.1:8090
NASUS_RUNNER_SERVICE_TOKEN=replace-with-a-random-runner-service-token
NASUS_RUNNER_ALLOWED_HOSTS=localhost,127.0.0.1
NASUS_RUNNER_PORT=8090
NASUS_RUNNER_MAX_CONCURRENCY=2
NASUS_RUNNER_MAX_BODY_BYTES=1048576
NASUS_RUNNER_MAX_ARTIFACT_BYTES=26214400
NASUS_RUNNER_REQUEST_TIMEOUT_SECONDS=130

# API authentication
# Local development defaults to NASUS_AUTH_MODE=dev, which uses the configured dev user without token enforcement.
# Production/staging must set NASUS_AUTH_MODE=required and a strong bearer token or replace this boundary with OIDC.
NASUS_AUTH_MODE=required
NASUS_AUTH_BEARER_TOKEN=replace-with-a-random-production-token
NASUS_AUTH_USER_ID=user_001
NASUS_AUTH_USER_NAME=Uben
NASUS_AUTH_USER_EMAIL=uben@example.com
NASUS_AUTH_USER_ROLE=platform_admin
NASUS_CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Shared API rate limiting. Production requires this PostgreSQL-backed limiter.
NASUS_RATE_LIMIT_ENABLED=false
NASUS_RATE_LIMIT_BACKEND=postgres
NASUS_RATE_LIMIT_WINDOW_SECONDS=60
NASUS_RATE_LIMIT_AUTH_PER_WINDOW=10
NASUS_RATE_LIMIT_AGENT_PER_WINDOW=30
NASUS_RATE_LIMIT_API_PER_WINDOW=120

# Portable disaster-recovery snapshots. Production additionally requires
# PostgreSQL PITR/WAL archive and MinIO/S3 replication or object lock.
NASUS_BACKUP_ROOT=.nasus/backups
NASUS_BACKUP_POSTGRES_DATABASES=nasus,temporal,temporal_visibility
NASUS_BACKUP_MANIFEST_HMAC_KEY=replace-with-a-random-backup-manifest-hmac-key

# Durable agent runtime
# staging/production must use temporal + langgraph and must disable demo seed.
NASUS_AGENT_WORKFLOW_RUNTIME=local
NASUS_AGENT_GRAPH_RUNTIME=local
NASUS_LANGGRAPH_CHECKPOINT_BACKEND=memory
NASUS_LANGGRAPH_AGENT_LOOP_GRAPH=nasus-agent-loop
NASUS_TEMPORAL_ADDRESS=
NASUS_TEMPORAL_NAMESPACE=default
NASUS_TEMPORAL_TASK_QUEUE=nasus-agent-goals
NASUS_TEMPORAL_AGENT_GOAL_WORKFLOW=NasusAgentGoalWorkflow
NASUS_TEMPORAL_CURRENT_GOAL_QUERY=current_goal
NASUS_TEMPORAL_RESUME_SIGNAL=resume_goal

# Portal authentication bridge for the current bearer-token boundary.
# In production, set this at build/deploy time or write nasus_api_token into localStorage after login.
VITE_NASUS_API_TOKEN=replace-with-the-api-bearer-token

# System-default chat model route.
# Use openai_compatible for DeepSeek, self-hosted gateways, or other OpenAI-compatible providers.
NASUS_DEFAULT_PROVIDER=openai_compatible
NASUS_DEFAULT_BASE_URL=https://your-openai-compatible-provider.example/v1
NASUS_DEFAULT_MODEL=your-chat-model
NASUS_DEFAULT_API_KEY=replace-with-your-chat-api-key

# System-default embedding route.
# The embedding route is independent from chat and is used by system-image indexing.
NASUS_EMBEDDING_PROVIDER=openai_compatible
NASUS_EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
NASUS_EMBEDDING_MODEL=your-embedding-model
NASUS_EMBEDDING_API_KEY=replace-with-your-embedding-api-key

# System-default rerank route.
# Providers do not share one universal rerank API; unsupported adapters must fall back with an audited RetrievalRun.
NASUS_RERANK_PROVIDER=openai_compatible
NASUS_RERANK_BASE_URL=https://your-rerank-provider.example/v1
NASUS_RERANK_MODEL=your-rerank-model
NASUS_RERANK_API_KEY=replace-with-your-rerank-api-key

# Optional shared OpenAI-compatible fallback values for routes that omit route-specific base URL/API key.
NASUS_OPENAI_COMPATIBLE_BASE_URL=
NASUS_OPENAI_COMPATIBLE_API_KEY=
