# ----------------------------------------------------------------------------
# AutoTest Platform - Docker Compose Environment
# Copy this file to .env and adjust values for your environment.
# ----------------------------------------------------------------------------

# Exposed ports on host
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Frontend API reverse proxy target (container-internal URL in compose)
API_PROXY_TARGET=http://backend-java:8080

# Spring profile
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=autotest
POSTGRES_USER=autotest
POSTGRES_PASSWORD=password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
EXECUTION_QUEUE_REDIS_KEY=platform:execution:queue
EXECUTION_QUEUE_CONSUMER_ENABLED=true
EXECUTION_QUEUE_POLL_INTERVAL_MS=300
EXECUTION_QUEUE_ERROR_BACKOFF_MS=1000

# Security
JWT_SECRET=AutoTestPlatformSecretKey2024SecureJwtTokenForEnterprise

# Spring AI / OpenAI
# Keep this placeholder value if you only need local mock fallback behavior.
# Set a real key for true model responses.
OPENAI_API_KEY=sk-local-placeholder
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
