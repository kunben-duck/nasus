# ----------------------------------------------------------------------------
# AutoTest Platform - Docker Compose Environment
# Copy this file to .env and adjust values for your environment.
# ----------------------------------------------------------------------------

# Exposed ports on host
FRONTEND_PORT=3000
BACKEND_PORT=8080
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Spring profile
SPRING_PROFILES_ACTIVE=prod

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=autotest
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Security
JWT_SECRET=AutoTestPlatformSecretKey2024SecureJwtTokenForEnterprise

# Spring AI / OpenAI
# Keep this placeholder value if you only need local mock fallback behavior.
# Set a real key for true model responses.
OPENAI_API_KEY=sk-local-placeholder
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
